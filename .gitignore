# Dependencies, interpreter caches and build outputs
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# Local runtime, browser profiles, screenshots and reports may contain game data
.runtime/
artifacts/
playwright-report/
test-results/
browser-profile*/
screenshots/
captures/
*.log

# Personal settings and credentials (package.json / package-lock.json are source)
.env
.env.*
.npmrc
.pypirc
config/
settings/
local/
.local/
config.json
settings.json
*.local.*
*credentials*.json
*secrets*.json
*tokens*.json
*.pem
*.key
*.p12
*.pfx

# Never check in copied Steam files, account/game exports or cache databases
userdata/
steamapps/
appcache/
cloudstorage/
librarycache/
data/
cache/
exports/
snapshots/
backups/
*.vdf
*.acf
licensecache
ssfn*
cloud-storage-*.json
*games*.json
*library*.json
*collections*.json
*accounts*.json
*.csv
*.sqlite*
*.db
*.db-*
*.bak
*.tmp

# Editor and OS-local settings
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
